# Server
PORT=6767

# Firebase / Firestore
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json

# Secret used to sign the QR payload returned with every registration.
# Any long random string; generate with: openssl rand -hex 32
QR_SIGNING_SECRET=

# Email domain that marks a user as a host-college student. This drives both
# event pricing (registrationFee.host vs registrationFee.other) and the
# sameCollegeOnly gate.
HOST_EMAIL_DOMAIN=thapar.edu

# Comma-separated list, or * to allow any origin.
ALLOWED_ORIGINS=http://localhost:8081

# How long a cached event snapshot is served before reloading. Admin writes
# and registrations invalidate it immediately regardless.
EVENT_CACHE_TTL=60s

# Redis is required; the API refuses to boot without it. The event cache keeps
# its shared snapshot there, plus the channel that drops every instance's local
# copy the moment anything changes. Without it each instance would serve its
# own stale view for up to EVENT_CACHE_TTL after someone else's write.
# Locally:  docker compose up -d redis
REDIS_URL=redis://localhost:6379/0

# Key prefix, so several environments can share one Redis without overwriting
# each other's snapshots.
REDIS_NAMESPACE=sat26

# Easebuzz credentials. EASEBUZZ_ENV is "test" (testpay.easebuzz.in) or "prod".
EASEBUZZ_KEY=
EASEBUZZ_SALT=
EASEBUZZ_ENV=test
# Public base URL of this API; Easebuzz posts its callback here.
APP_BASE_URL=http://localhost:6767
# Local development only: serves /payments/dummy, a fake checkout that marks any
# payment paid. Never enable in production.
PAYMENTS_DUMMY=false

# Local development against the emulators (see firebase.json). When these are
# set the service account is not needed.
# FIRESTORE_EMULATOR_HOST=localhost:8081
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Path to the JSON array of ImageKit accounts that internal/storage spreads
# uploads across. Each upload lands on whichever account has the most bytes
# free, so several small free-tier accounts add up to one usable quota. Copy
# imagekit.json.example, fill in the keys from each account's dashboard, and
# set quotaBytes to that account's plan limit -- nothing can read the real
# limit from a per-account key, so it is declared here.
# Leave this unset if nothing uploads files yet; the API boots without it.
IMAGEKIT_ACCOUNTS_FILE=./imagekit.json

# Local JSON file path for app configuration (links, maintenance, versions, accommodation)
APP_CONFIG_FILE=app_config.json
