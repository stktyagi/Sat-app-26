rules_version = '2';

// Every client request goes through the Go API, which uses the Admin SDK and
// bypasses these rules. No app talks to Firestore directly, so direct client
// access is denied outright.
//
// This replaces the default starter rule, which allowed anyone to read and
// write the entire database and was set to expire on 2026-09-22.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
