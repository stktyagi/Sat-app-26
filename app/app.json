{
  "expo": {
    "name": "Saturnalia",
    "slug": "saturnalia",
    "version": "1.3",
    "orientation": "portrait",
    "icon": "./assets/icons/adaptive-icon.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "dark": "./assets/icons/ios-dark.png",
        "light": "./assets/icons/ios-light.png",
        "tinted": "./assets/icons/ios-tinted.png"
      },
      "bundleIdentifier": "aaravgupta.events",
      "appleTeamId": "3YK32DPS3W",
      "buildNumber": "6",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Saturnalia needs camera access to scan event tickets, merchandise QR codes, and entry passes.",
        "NSPhotoLibraryUsageDescription": "Saturnalia needs photo library access to upload stories, profile photos, and festival reels.",
        "NSPhotoLibraryAddUsageDescription": "Saturnalia needs permission to save ticket passes and media to your gallery.",
        "NSLocationWhenInUseUsageDescription": "Saturnalia needs your location to show campus navigation and guide you to event venues.",
        "UIBackgroundModes": ["remote-notification"],
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytmmp",
          "bhim"
        ]
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "monochromeImage": "./assets/icons/adaptive-icon.png"
      },
      "versionCode": 13,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": true,
      "package": "com.gauransh.saturnaliaapp2026",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/icons/splash-icon-dark.png"
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "@react-native-firebase/auth",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.427621506808-o5nqljprovsajeba0n204thlsp1p7l5m"
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsDownloadToken": "sk.eyJ1IjoiamFzaGFuMjAwMyIsImEiOiJjbWdiYnEzNG8wZGdxMmtzZWpqMzAybGQyIn0.VjzyzNTQnJa1I-MMuHkk_g"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class com.easebuzz.** { *; }\n-dontwarn com.easebuzz.**\n-keep class in.easebuzz.** { *; }\n-dontwarn in.easebuzz.**\n-keep class com.mapbox.maps.** { *; }\n-dontwarn com.mapbox.maps.**\n-keep class com.mapbox.geojson.** { *; }\n-dontwarn com.mapbox.geojson.**\n-keep class com.mapbox.turf.** { *; }\n-dontwarn com.mapbox.turf.**\n-keep class com.rnmapbox.rnmbx.** { *; }\n-dontwarn com.rnmapbox.rnmbx.**\n-keepattributes *Annotation*\n-keepattributes Signature\n-keepattributes InnerClasses\n-keepattributes EnclosingMethod"
          },
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      "expo-sharing",
      "expo-video",
      "react-native-video",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "./plugins/withSceneLifecycle.js",
      "./plugins/withSwift5Pods.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "387c8bcf-40be-477b-af17-b88b14e01379"
      }
    },
    "owner": "gauransharora"
  }
}
